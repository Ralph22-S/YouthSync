APP_ENV=development
# Production refuses to boot unless APP_DEBUG=false, SESSION_SECURE=true,
# DEMO_MODE=false, and DB_PASSWORD is set. SMS and email keys may stay empty.
APP_DEBUG=true
APP_URL=http://localhost/YouthSync_UI_Refresh/api
APP_BASE_PATH=/YouthSync_UI_Refresh/api
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
# This XAMPP checkout uses 3307. Standard XAMPP is often 3306 — match my.ini.
DB_PORT=3307
DB_NAME=youthsync
DB_USER=root
DB_PASSWORD=
# Optional. Defaults to C:\xampp\mysql\bin\mysqldump.exe on this machine.
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe

SESSION_NAME=youthsync_session
SESSION_SAMESITE=Lax
SESSION_SECURE=false
# Persistent session when Remember me is checked (seconds). Default 30 days.
SESSION_REMEMBER_LIFETIME=2592000

# Secret for POST /cron/run (header X-Cron-Secret). Leave empty to refuse the HTTP route.
# The CLI scheduler (api/bin/scheduler.php) does not use this value.
CRON_SECRET=

# Local demo only. Must stay false in production.
# When true AND APP_ENV is not production, DEMO_LOGIN_EMAIL accepts any non-empty password.
# Seeded SK accounts still use the documented local password YouthSync1! when DEMO_MODE=false.
DEMO_MODE=false
DEMO_LOGIN_EMAIL=sk1@demo.test

# Semaphore SMS. Leave the API key empty to disable sending. The app still runs.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_BASE_URL=https://api.semaphore.co

# Brevo transactional email. Leave the API key or sender empty to disable sending. The app still runs.
# The sender address must be verified in the Brevo account. Free plan: 300 emails per day.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=YouthSync
BREVO_BASE_URL=https://api.brevo.com

# System Administrator. Used only to create the account if it does not exist.
# Leave ADMIN_PASSWORD empty to use the local default documented in README.
ADMIN_EMAIL=admin@skmms.test
ADMIN_PASSWORD=

# PayMongo online subscription payments (hosted checkout). See docs/PAYMONGO_SETUP.md.
# Leave PAYMONGO_SECRET_KEY or PAYMONGO_WEBHOOK_SECRET empty to disable online payment.
# Never commit real values; api/.env is git-ignored. Start with TEST keys (sk_test_...).
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
# Signing secret of the webhook endpoint (whsk_...), NOT the API secret key.
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated payment_method_types to offer, e.g. card,gcash,paymaya (only methods
# activated on your PayMongo account will work). Empty = online payment disabled.
PAYMONGO_ALLOWED_METHODS=
# Where PayMongo sends the customer back. {id} is replaced with the internal transaction id.
# These pages only show status; they never activate a plan.
PAYMONGO_SUCCESS_URL=http://localhost:5173/sk/subscription/payment/success?tx={id}
PAYMONGO_CANCEL_URL=http://localhost:5173/sk/subscription/payment/cancel?tx={id}
# Seconds a webhook timestamp may differ from server time.
PAYMONGO_WEBHOOK_TOLERANCE=300
# TEST mode only: allow the status page poll to activate from a server-side checkout-session
# fetch when no public webhook URL exists. Ignored in live mode. Keep false otherwise.
PAYMONGO_CONFIRM_BY_RETRIEVAL=false
# Test-only override for the MOCK server used by api/sql/payments_http_test.php. Leave unset.
# PAYMONGO_API_BASE=https://api.paymongo.com
# PAYMONGO_TEST_FAULT is used only by the MOCK test suite (api/sql/payment_verification_http_test.php) and is
# ignored unless PAYMONGO_MODE=test and PAYMONGO_API_BASE is a loopback http MOCK. Never set it here.
