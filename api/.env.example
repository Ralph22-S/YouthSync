APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/YouthSync_UI_Refresh/api
APP_BASE_PATH=/YouthSync_UI_Refresh/api
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=youthsync
DB_USER=root
DB_PASSWORD=

SESSION_NAME=youthsync_session
SESSION_SAMESITE=Lax
SESSION_SECURE=false
# Persistent session when Remember me is checked (seconds). Default 30 days.
SESSION_REMEMBER_LIFETIME=2592000

# Local demo only. Must stay false in production.
DEMO_MODE=false
DEMO_LOGIN_EMAIL=sk1@demo.test
