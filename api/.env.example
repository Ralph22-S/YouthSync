APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/YouthSync_UI_Refresh/api
APP_BASE_PATH=/YouthSync_UI_Refresh/api
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
# This XAMPP checkout uses 3307. Standard XAMPP is often 3306 — match my.ini.
DB_PORT=3307
DB_NAME=youthsync
DB_USER=root
DB_PASSWORD=

SESSION_NAME=youthsync_session
SESSION_SAMESITE=Lax
SESSION_SECURE=false
# Persistent session when Remember me is checked (seconds). Default 30 days.
SESSION_REMEMBER_LIFETIME=2592000

# Local demo only. Must stay false in production.
# When true AND APP_ENV is not production, DEMO_LOGIN_EMAIL accepts any non-empty password.
# Seeded SK accounts still use the documented local password YouthSync1! when DEMO_MODE=false.
DEMO_MODE=false
DEMO_LOGIN_EMAIL=sk1@demo.test

# Semaphore SMS. Leave the API key empty to disable sending.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_BASE_URL=https://api.semaphore.co
