# Copy this to api/.env ON THE SERVER only. Do not use it on XAMPP.
# Production refuses to start unless every check below is met.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN/api
APP_BASE_PATH=/api
FRONTEND_ORIGIN=https://YOUR_DOMAIN

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=youthsync
DB_USER=youthsync
DB_PASSWORD=REPLACE_WITH_A_DATABASE_PASSWORD

SESSION_NAME=youthsync_session
SESSION_SAMESITE=Lax
SESSION_SECURE=true
SESSION_REMEMBER_LIFETIME=2592000

CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

DEMO_MODE=false
DEMO_LOGIN_EMAIL=

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_BASE_URL=https://api.semaphore.co

BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=YouthSync
BREVO_BASE_URL=https://api.brevo.com

ADMIN_EMAIL=
ADMIN_PASSWORD=

PAYMONGO_MODE=live
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ALLOWED_METHODS=
PAYMONGO_SUCCESS_URL=https://YOUR_DOMAIN/sk/subscription/payment/success?tx={id}
PAYMONGO_CANCEL_URL=https://YOUR_DOMAIN/sk/subscription/payment/cancel?tx={id}
PAYMONGO_WEBHOOK_TOLERANCE=300
PAYMONGO_CONFIRM_BY_RETRIEVAL=false
